---
import Layout from '../layouts/Layout.astro';
import ThreeHero from '../components/ThreeHero.astro';
---

<Layout title="Astro + Three.js | High-Performance 3D Landing Page">
  <header class="site-header">
    <div class="header-inner">
      <a href="/" class="brand-logo" aria-label="Astro Three.js Home">
        <span class="logo-gem">◈</span>
        <span class="brand-name">Astro<strong>3D</strong></span>
      </a>
      <nav class="nav-links" aria-label="Main Navigation">
        <a href="#features" class="nav-link">Features</a>
        <a href="#architecture" class="nav-link">Architecture</a>
        <a
          href="https://github.com/rodydavis/agy-test"
          target="_blank"
          rel="noopener noreferrer"
          class="nav-link github-link"
        >
          GitHub
        </a>
      </nav>
    </div>
  </header>

  <main>
    <ThreeHero id="hero">
      <div class="hero-badge">
        <span class="badge-dot"></span>
        <span>✨ Modern Web Architecture</span>
      </div>

      <h1 class="hero-title">
        High-Performance 3D with <br class="title-break" />
        <span class="text-gradient">Zero-JS Initial Paint</span>
      </h1>

      <p class="hero-subtitle">
        Pre-rendered semantic HTML with an isolated client-side WebGL canvas,
        automatic GPU power conservation, and full accessibility.
      </p>

      <div class="hero-actions">
        <a href="#features" class="btn btn-primary">
          <span>Explore Demo</span>
          <svg class="btn-arrow" viewBox="0 0 20 20" fill="currentColor" width="18" height="18" aria-hidden="true">
            <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
          </svg>
        </a>
        <a
          href="https://github.com/rodydavis/agy-test"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-secondary"
        >
          View Source
        </a>
      </div>

      <div class="status-pill" aria-live="polite">
        <span class="status-indicator"></span>
        <span class="status-text">Three.js WebGL Engine: <strong>Active</strong></span>
      </div>
    </ThreeHero>

    <section id="features" class="features-section">
      <div class="section-container">
        <div class="section-header">
          <span class="section-eyebrow">Key Capabilities</span>
          <h2 class="section-title">Engineered for Extreme Speed & Efficiency</h2>
          <p class="section-desc">
            Bridging native WebGL performance with Astro's zero-JavaScript default baseline.
          </p>
        </div>

        <div class="features-grid">
          <div class="feature-card">
            <div class="card-icon" aria-hidden="true">⚡</div>
            <h3 class="card-title">Zero Framework Tax</h3>
            <p class="card-text">
              Direct vanilla Three.js running in an isolated Astro client script without heavyweight component wrappers or virtual DOM overhead.
            </p>
          </div>

          <div class="feature-card">
            <div class="card-icon" aria-hidden="true">🔋</div>
            <h3 class="card-title">Intelligent GPU Pausing</h3>
            <p class="card-text">
              Combines <code>IntersectionObserver</code> and <code>contentvisibilityautostatechange</code> to halt the rendering loop when scrolled out of view, saving battery and thermals.
            </p>
          </div>

          <div class="feature-card">
            <div class="card-icon" aria-hidden="true">♿</div>
            <h3 class="card-title">Accessibility First</h3>
            <p class="card-text">
              ARIA-hidden canvas paired with semantic SSR HTML, high-contrast readable typography, and strict <code>prefers-reduced-motion</code> static rendering.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section id="architecture" class="architecture-section">
      <div class="section-container">
        <div class="section-header">
          <span class="section-eyebrow">Under The Hood</span>
          <h2 class="section-title">Zero Asset Overhead</h2>
          <p class="section-desc">
            100% procedural geometry and particle generation means 0 external .gltf downloads and instant rendering.
          </p>
        </div>

        <div class="specs-grid">
          <div class="spec-card">
            <div class="spec-value">0 KB</div>
            <div class="spec-label">External 3D Asset Files</div>
          </div>
          <div class="spec-card">
            <div class="spec-value">1,500</div>
            <div class="spec-label">Interactive Star Particles</div>
          </div>
          <div class="spec-card">
            <div class="spec-value">60 FPS</div>
            <div class="spec-label">Hardware-Accelerated WebGL</div>
          </div>
          <div class="spec-card">
            <div class="spec-value">2x DPR</div>
            <div class="spec-label">Clamped Pixel Density</div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <p class="footer-copy">
        Built with <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a> &amp;
        <a href="https://threejs.org" target="_blank" rel="noopener noreferrer">Three.js</a>.
      </p>
      <p class="footer-meta">Repository: <a href="https://github.com/rodydavis/agy-test" target="_blank" rel="noopener noreferrer">rodydavis/agy-test</a></p>
    </div>
  </footer>
</Layout>

<style>
  /* Header */
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    background: rgba(8, 9, 13, 0.75);
    border-bottom: 1px solid var(--border-subtle);
  }

  .header-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .brand-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .logo-gem {
    color: var(--accent-sky);
    font-size: 1.4rem;
  }

  .brand-name strong {
    color: var(--accent-indigo);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-link {
    font-size: 0.95rem;
    color: var(--text-secondary);
    transition: color 0.2s ease;
  }

  .nav-link:hover {
    color: var(--text-primary);
  }

  .github-link {
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-subtle);
  }

  .github-link:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  /* Hero Content */
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 1rem;
    margin-bottom: 1.5rem;
    border-radius: 9999px;
    background: rgba(99, 102, 241, 0.12);
    border: 1px solid var(--border-accent);
    color: #c7d2fe;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #38bdf8;
    box-shadow: 0 0 8px #38bdf8;
  }

  .hero-title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin-bottom: 1.5rem;
  }

  .text-gradient {
    background: linear-gradient(135deg, #38bdf8 0%, #818cf8 50%, #c084fc 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-subtitle {
    max-width: 680px;
    margin: 0 auto 2.25rem;
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.75rem;
    border-radius: 0.75rem;
    font-size: 1rem;
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .btn-primary {
    background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
    color: #ffffff;
    box-shadow: 0 4px 20px rgba(99, 102, 241, 0.4);
  }

  .btn-primary:hover {
    box-shadow: 0 6px 24px rgba(99, 102, 241, 0.6);
    transform: translateY(-2px);
  }

  .btn-secondary {
    background: rgba(255, 255, 255, 0.05);
    color: var(--text-primary);
    border: 1px solid var(--border-subtle);
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.2);
    transform: translateY(-2px);
  }

  .btn-arrow {
    transition: transform 0.2s ease;
  }

  .btn-primary:hover .btn-arrow {
    transform: translateX(3px);
  }

  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    background: rgba(18, 20, 28, 0.8);
    border: 1px solid var(--border-subtle);
    font-size: 0.8rem;
    color: var(--text-secondary);
  }

  .status-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 6px #10b981;
  }

  /* Section Styling */
  .section-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 6rem 1.5rem;
  }

  .section-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 4rem;
  }

  .section-eyebrow {
    display: inline-block;
    color: var(--accent-sky);
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.75rem;
  }

  .section-title {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }

  .section-desc {
    color: var(--text-secondary);
    font-size: 1.1rem;
  }

  /* Features Grid */
  .features-section {
    background: #0b0d13;
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .feature-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 1rem;
    padding: 2.25rem;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .feature-card:hover {
    transform: translateY(-4px);
    border-color: var(--border-accent);
  }

  .card-icon {
    font-size: 2rem;
    margin-bottom: 1.25rem;
  }

  .card-title {
    font-size: 1.35rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    color: var(--text-primary);
  }

  .card-text {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .card-text code {
    background: rgba(255, 255, 255, 0.08);
    padding: 0.15rem 0.4rem;
    border-radius: 0.25rem;
    font-size: 0.85em;
    color: #e2e8f0;
  }

  /* Specs Grid */
  .architecture-section {
    background: var(--bg-main);
  }

  .specs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
  }

  .spec-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 0.85rem;
    padding: 2rem 1.5rem;
    text-align: center;
  }

  .spec-value {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--accent-sky);
    margin-bottom: 0.5rem;
    letter-spacing: -0.02em;
  }

  .spec-label {
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  /* Footer */
  .site-footer {
    border-top: 1px solid var(--border-subtle);
    background: #050608;
    padding: 2.5rem 1.5rem;
  }

  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    color: var(--text-muted);
    font-size: 0.875rem;
  }

  .footer-inner a {
    color: var(--text-secondary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer-inner a:hover {
    color: var(--text-primary);
  }

  @media (max-width: 640px) {
    .title-break {
      display: none;
    }
    .features-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
