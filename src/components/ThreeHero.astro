---
interface Props {
  id?: string;
  class?: string;
}

const { id = "hero", class: className = "" } = Astro.props;
---

<section id={id} class:list={["three-hero-container", className]}>
  <canvas id="three-hero-canvas" class="three-hero-canvas" aria-hidden="true"></canvas>
  <div class="three-hero-content">
    <slot />
  </div>
</section>

<style>
  .three-hero-container {
    position: relative;
    width: 100%;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: radial-gradient(circle at 50% 40%, #151828 0%, #08090d 80%, #050608 100%);
  }

  .three-hero-canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
    display: block;
  }

  .three-hero-content {
    position: relative;
    z-index: 10;
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
    pointer-events: auto;
    text-align: center;
  }
</style>

<script>
  let activeCleanup: (() => void) | null = null;

  async function initThreeHero() {
    const container = document.querySelector<HTMLElement>('.three-hero-container');
    const canvas = document.querySelector<HTMLCanvasElement>('#three-hero-canvas');

    if (!container || !canvas) return;

    // Prevent double initialization
    if (canvas.dataset.threeInitialized === 'true') return;
    canvas.dataset.threeInitialized = 'true';

    // Status pill dynamic updater
    const statusText = document.querySelector<HTMLElement>('.status-text');
    const statusIndicator = document.querySelector<HTMLElement>('.status-indicator');

    function updateStatus(state: 'active' | 'standby' | 'reduced-motion' | 'fallback') {
      if (!statusText || !statusIndicator) return;
      if (state === 'active') {
        statusIndicator.style.background = '#10b981';
        statusIndicator.style.boxShadow = '0 0 6px #10b981';
        statusText.innerHTML = 'Three.js WebGL Engine: <strong>Active (60 FPS)</strong>';
      } else if (state === 'standby') {
        statusIndicator.style.background = '#f59e0b';
        statusIndicator.style.boxShadow = '0 0 6px #f59e0b';
        statusText.innerHTML = 'Three.js WebGL Engine: <strong>Standby (GPU Idle)</strong>';
      } else if (state === 'reduced-motion') {
        statusIndicator.style.background = '#38bdf8';
        statusIndicator.style.boxShadow = '0 0 6px #38bdf8';
        statusText.innerHTML = 'Three.js WebGL Engine: <strong>Static (Reduced Motion)</strong>';
      } else if (state === 'fallback') {
        statusIndicator.style.background = '#94a3b8';
        statusIndicator.style.boxShadow = 'none';
        statusText.innerHTML = 'Three.js WebGL Engine: <strong>CSS Fallback Mode</strong>';
      }
    }

    // Dynamically load Three.js to preserve Zero-JS Initial Paint
    let THREE: typeof import('three');
    try {
      THREE = await import('three');
    } catch (err) {
      console.warn('Failed to load Three.js:', err);
      updateStatus('fallback');
      return;
    }

    // 1. Scene & Camera
    const scene = new THREE.Scene();
    let width = container.clientWidth || window.innerWidth;
    let height = container.clientHeight || window.innerHeight;

    const camera = new THREE.PerspectiveCamera(55, width / height, 0.1, 1000);

    function updateCameraZ(w: number, h: number) {
      const aspect = w / h;
      if (aspect < 1) {
        // Mobile portrait: pull camera back so the knot is fully visible without clipping
        camera.position.z = Math.min(8.5, (5.5 / aspect) * 0.72);
      } else {
        camera.position.z = 5.5;
      }
    }
    updateCameraZ(width, height);

    // 2. WebGL Renderer with DPR clamping & error handling
    let renderer: InstanceType<typeof THREE.WebGLRenderer>;
    try {
      renderer = new THREE.WebGLRenderer({
        canvas,
        antialias: true,
        alpha: true,
        powerPreference: 'high-performance'
      });
      renderer.setSize(width, height, false);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
    } catch (err) {
      console.warn('WebGL context creation failed, falling back:', err);
      updateStatus('fallback');
      return;
    }

    // 3. Procedural Glowing Centerpiece (Torus Knot + Core Sphere) inside Hero Group
    const heroGroup = new THREE.Group();
    scene.add(heroGroup);

    const knotGeometry = new THREE.TorusKnotGeometry(1.5, 0.42, 128, 32);
    const knotMaterial = new THREE.MeshStandardMaterial({
      color: 0x6366f1,
      roughness: 0.25,
      metalness: 0.85,
      wireframe: true,
      emissive: 0x4338ca,
      emissiveIntensity: 0.45
    });
    const knotMesh = new THREE.Mesh(knotGeometry, knotMaterial);
    heroGroup.add(knotMesh);

    // Inner glowing core
    const coreGeometry = new THREE.IcosahedronGeometry(0.85, 2);
    const coreMaterial = new THREE.MeshStandardMaterial({
      color: 0x38bdf8,
      roughness: 0.2,
      metalness: 0.9,
      wireframe: true,
      emissive: 0x0284c7,
      emissiveIntensity: 0.7
    });
    const coreMesh = new THREE.Mesh(coreGeometry, coreMaterial);
    heroGroup.add(coreMesh);

    // 4. Floating Particle Constellation (1,500 particles)
    const particleCount = 1500;
    const particlePositions = new Float32Array(particleCount * 3);
    const particleColors = new Float32Array(particleCount * 3);

    const c1 = new THREE.Color(0x6366f1); // Indigo
    const c2 = new THREE.Color(0x38bdf8); // Sky blue
    const c3 = new THREE.Color(0xa855f7); // Purple

    for (let i = 0; i < particleCount; i++) {
      const idx = i * 3;
      particlePositions[idx] = (Math.random() - 0.5) * 24;
      particlePositions[idx + 1] = (Math.random() - 0.5) * 24;
      particlePositions[idx + 2] = (Math.random() - 0.5) * 18;

      const pick = i % 3;
      const col = pick === 0 ? c1 : pick === 1 ? c2 : c3;
      particleColors[idx] = col.r;
      particleColors[idx + 1] = col.g;
      particleColors[idx + 2] = col.b;
    }

    const particleGeometry = new THREE.BufferGeometry();
    particleGeometry.setAttribute('position', new THREE.BufferAttribute(particlePositions, 3));
    particleGeometry.setAttribute('color', new THREE.BufferAttribute(particleColors, 3));

    const particleMaterial = new THREE.PointsMaterial({
      size: 0.045,
      vertexColors: true,
      transparent: true,
      opacity: 0.75,
      blending: THREE.AdditiveBlending
    });
    const particleSystem = new THREE.Points(particleGeometry, particleMaterial);
    scene.add(particleSystem);

    // 5. Lighting
    const ambientLight = new THREE.AmbientLight(0xffffff, 0.7);
    scene.add(ambientLight);

    const pointLight1 = new THREE.PointLight(0x6366f1, 30, 50);
    pointLight1.position.set(5, 4, 4);
    scene.add(pointLight1);

    const pointLight2 = new THREE.PointLight(0x38bdf8, 25, 50);
    pointLight2.position.set(-5, -4, 3);
    scene.add(pointLight2);

    // 6. Smooth Pointer Parallax with Inertial Interpolation
    let targetX = 0;
    let targetY = 0;
    let currentX = 0;
    let currentY = 0;

    function handlePointerMove(e: PointerEvent) {
      const halfW = window.innerWidth / 2;
      const halfH = window.innerHeight / 2;
      targetX = (e.clientX - halfW) * 0.0008;
      targetY = (e.clientY - halfH) * 0.0008;
    }

    function handlePointerReset() {
      targetX = 0;
      targetY = 0;
    }

    window.addEventListener('pointermove', handlePointerMove, { passive: true });
    window.addEventListener('pointerleave', handlePointerReset);
    window.addEventListener('pointerup', handlePointerReset);
    window.addEventListener('pointercancel', handlePointerReset);

    // 7. Responsive Canvas Resize Observer
    function applyDimensions(newW: number, newH: number) {
      width = newW;
      height = newH;
      camera.aspect = width / height;
      updateCameraZ(width, height);
      camera.updateProjectionMatrix();
      renderer.setSize(width, height, false);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
      if (isReducedMotion) {
        renderer.render(scene, camera);
      }
    }

    const resizeObserver = new ResizeObserver((entries) => {
      for (const entry of entries) {
        const { width: w, height: h } = entry.contentRect;
        if (w > 0 && h > 0) {
          applyDimensions(w, h);
        }
      }
    });
    resizeObserver.observe(container);

    function handleWindowResize() {
      if (!container) return;
      applyDimensions(container.clientWidth || window.innerWidth, container.clientHeight || window.innerHeight);
    }
    window.addEventListener('resize', handleWindowResize, { passive: true });

    // 8. Accessibility & Reduced Motion Handling
    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    let isReducedMotion = motionQuery.matches;

    function handleMotionChange(e: MediaQueryListEvent) {
      isReducedMotion = e.matches;
      if (isReducedMotion) {
        stopLoop();
        heroGroup.rotation.set(0.15, 0.25, 0);
        camera.position.set(0, 0, camera.position.z);
        renderer.render(scene, camera);
        updateStatus('reduced-motion');
      } else if (isIntersecting && !document.hidden) {
        startLoop();
      }
    }

    if (motionQuery.addEventListener) {
      motionQuery.addEventListener('change', handleMotionChange);
    } else {
      (motionQuery as any).addListener(handleMotionChange);
    }

    // 9. Battery & Resource Optimization: IntersectionObserver & Visibility
    let isIntersecting = true;
    let animationFrameId: number | null = null;
    let lastTime = performance.now();

    // Autonomous base rotation angles
    let baseRotX = 0;
    let baseRotY = 0;
    let baseCoreRotX = 0;
    let baseCoreRotY = 0;
    let baseParticleRotY = 0;

    function renderFrame(time: number) {
      if (!isIntersecting || document.hidden || isReducedMotion) {
        animationFrameId = null;
        return;
      }

      animationFrameId = requestAnimationFrame(renderFrame);

      const delta = Math.min((time - lastTime) / 1000, 0.1);
      lastTime = time;

      // Smooth parallax lerp
      currentX += (targetX - currentX) * 0.05;
      currentY += (targetY - currentY) * 0.05;

      // Base autonomous rotations (steady, framerate-independent)
      baseRotX += 0.22 * delta;
      baseRotY += 0.32 * delta;
      baseCoreRotX -= 0.18 * delta;
      baseCoreRotY -= 0.26 * delta;
      baseParticleRotY += 0.035 * delta;

      knotMesh.rotation.set(baseRotX, baseRotY, 0);
      coreMesh.rotation.set(baseCoreRotX, baseCoreRotY, 0);

      // Smooth parallax tilt applied to heroGroup without runaway acceleration
      heroGroup.rotation.x = currentY * 0.5;
      heroGroup.rotation.y = currentX * 0.5;

      // Parallax tilt on particle constellation
      particleSystem.rotation.x = currentY * 0.25;
      particleSystem.rotation.y = baseParticleRotY + currentX * 0.15;
      particleSystem.rotation.z = currentX * 0.1;

      // Subtle camera parallax offset for genuine depth perception
      camera.position.x = currentX * 0.6;
      camera.position.y = -currentY * 0.6;
      camera.lookAt(0, 0, 0);

      renderer.render(scene, camera);
    }

    function startLoop() {
      if (!animationFrameId && isIntersecting && !document.hidden && !isReducedMotion) {
        lastTime = performance.now();
        animationFrameId = requestAnimationFrame(renderFrame);
        updateStatus('active');
      }
    }

    function stopLoop() {
      if (animationFrameId) {
        cancelAnimationFrame(animationFrameId);
        animationFrameId = null;
      }
      if (!isReducedMotion) {
        updateStatus('standby');
      }
    }

    // IntersectionObserver to pause loop when off-screen
    const intersectionObserver = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        isIntersecting = entry.isIntersecting;
        if (isIntersecting) {
          startLoop();
        } else {
          stopLoop();
        }
      }
    }, { threshold: 0.05 });
    intersectionObserver.observe(container);

    // Document visibility change (tab switching)
    function handleVisibilityChange() {
      if (document.hidden) {
        stopLoop();
      } else if (isIntersecting && !isReducedMotion) {
        startLoop();
      }
    }
    document.addEventListener('visibilitychange', handleVisibilityChange);

    // Initial render / loop start
    if (isReducedMotion) {
      heroGroup.rotation.set(0.15, 0.25, 0);
      renderer.render(scene, camera);
      updateStatus('reduced-motion');
    } else {
      startLoop();
    }

    // 10. Comprehensive Teardown & Resource Disposal Logic
    function cleanup() {
      stopLoop();
      window.removeEventListener('pointermove', handlePointerMove);
      window.removeEventListener('pointerleave', handlePointerReset);
      window.removeEventListener('pointerup', handlePointerReset);
      window.removeEventListener('pointercancel', handlePointerReset);
      window.removeEventListener('resize', handleWindowResize);
      if (motionQuery.removeEventListener) {
        motionQuery.removeEventListener('change', handleMotionChange);
      } else {
        (motionQuery as any).removeListener(handleMotionChange);
      }
      document.removeEventListener('visibilitychange', handleVisibilityChange);
      intersectionObserver.disconnect();
      resizeObserver.disconnect();

      // Dispose Three.js WebGL resources
      knotGeometry.dispose();
      knotMaterial.dispose();
      coreGeometry.dispose();
      coreMaterial.dispose();
      particleGeometry.dispose();
      particleMaterial.dispose();
      renderer.dispose();
      renderer.forceContextLoss();

      if (canvas) {
        delete canvas.dataset.threeInitialized;
      }
      activeCleanup = null;
    }

    activeCleanup = cleanup;
    document.addEventListener('astro:before-swap', cleanup, { once: true });
    window.addEventListener('beforeunload', cleanup, { once: true });
  }

  // Schedule initialization during idle to preserve Zero-JS initial paint
  function scheduleInit() {
    if (activeCleanup) {
      activeCleanup();
    }
    if ('requestIdleCallback' in window) {
      (window as any).requestIdleCallback(() => initThreeHero(), { timeout: 1200 });
    } else {
      setTimeout(initThreeHero, 10);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', scheduleInit, { once: true });
  } else {
    scheduleInit();
  }

  document.addEventListener('astro:page-load', scheduleInit);
</script>
